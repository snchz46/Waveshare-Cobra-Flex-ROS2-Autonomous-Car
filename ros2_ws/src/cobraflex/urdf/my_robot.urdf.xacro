<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find cobraflex)/urdf/common_properties.xacro" />
    <xacro:include filename="$(find cobraflex)/urdf/mobile_base.xacro" />
    <xacro:include filename="$(find cobraflex)/urdf/mobile_base_gazebo.xacro" />

    <!-- Sensors -->
    <xacro:include filename="$(find cobraflex)/urdf/rplidar_a2.urdf.xacro"/>  
    <xacro:include filename="$(find cobraflex)/urdf/camera.xacro" />
    <xacro:include filename="$(find cobraflex)/urdf/imu.urdf.xacro" />

</robot>