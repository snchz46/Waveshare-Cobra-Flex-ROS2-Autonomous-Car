<launch>
    <!-- Layer 2: all sensors of the platform.

         The lane camera (Jetson CSI) is started here together with the LiDAR
         and the ZED, so that the bring-up consists of three commands:

             1. cobraflex_bringup.launch.xml   description + ROS->JSON driver
             2. cobraflex_sensors.launch.xml   LiDAR + ZED + lane camera + EKF
             3. a layer-3 controller (e.g. cobraflex_rl deploy_cobraflex.launch.py)

         Consequences of opening the camera in this layer:

         * `deploy_cobraflex.launch.py` defaults to `camera:=false` and
           subscribes to `camera/image_raw_lane` instead of opening the device
           again. nvarguscamerasrc does not allow shared access; a second
           opener fails to start.
         * `cobraflex_lane_keeper.launch.py` (classical CV controller) opens
           the CSI device inside `lane_keeper_node`. In that case this file is
           started with `use_lane_camera:=false`.
    -->

    <arg name="use_lane_camera" default="true"/>
    <arg name="lane_camera_sensor_id" default="0"/>
    <arg name="lane_camera_flip_method" default="0"/>
    <arg name="lane_camera_topic" default="camera/image_raw_lane"/>

    <!-- ================= Lidar SLLIDAR A2M8 ================= -->
    <include file="$(find-pkg-share sllidar_ros2)/launch/sllidar_a2m8_launch.py">
        <arg name="frame_id" value="lidar_link"/>
    </include>

    <!-- ================= ZED Camera (ZED Mini) ================= -->
    <include file="$(find-pkg-share zed_wrapper)/launch/zed_camera.launch.py">
        <arg name="camera_model" value="zedm"/>
        <arg name="camera_name" value="zed"/>
        <!-- Disabled: my_robot_basic.urdf instantiates the zed_camera macro, so
             the wrapper must not publish a second description. -->
        <arg name="publish_urdf" value="false"/>
        <!-- Disabled. With the default value the wrapper broadcasts
             odom -> zed_camera_link, which conflicts with odom -> base_footprint
             of the EKF (two publishers rooted at odom, zed_camera_link reachable
             by two paths). The EKF is the only publisher of that edge; the ZED
             contributes only the /zed/zed_node/odom topic, which depends on
             positional tracking and not on publish_tf. -->
        <arg name="publish_tf" value="false"/>

        <!-- ZED IMU -->
        <arg name="publish_imu_tf" value="true"/>

        <!-- ZED Mapping -->
        <arg name="publish_map_tf" value="false"/>
        <!-- No effect; documents the intended value. zed_camera.launch.py does not
             declare this argument, and ROS 2 converts undeclared launch
             arguments into unused LaunchConfigurations without a warning. The
             effective value is `true`, from config/common_stereo.yaml of the
             wrapper. Open item: on loop closure the ZED odometry jumps; the jump
             enters the EKF as an absolute pose with ~1e-5 covariance and
             odom0_differential:false, so the filter follows it and produces a
             spurious velocity peak in the speed input of the cage. REP-105
             requires a continuous odom frame, with jumps confined to map. The
             value is changed in the wrapper YAML or through
             ros_params_override_path. -->
        <arg name="reset_odom_with_loop_closure" value="true"/>
    </include>

    <!-- ============ Lane camera (Jetson CSI, IMX219-160) ============
         Read by both the RL policy and the D-43 cage estimator. The frame
         geometry is not exposed as an argument: csi_camera_node uses
         640x360 / 90 deg / 20 Hz from `camera_geometry`, and any other size
         produces incorrect ey/epsi values for the cage. -->
    <node pkg="cobraflex_rl" exec="csi_camera_node" name="csi_camera_node"
          output="screen" if="$(var use_lane_camera)">
        <param name="image_topic" value="$(var lane_camera_topic)"/>
        <param name="sensor_id" value="$(var lane_camera_sensor_id)"/>
        <param name="flip_method" value="$(var lane_camera_flip_method)"/>
    </node>

    <!-- ================= State estimation =================
         Fuses the ZED visual odometry into /odometry/filtered and publishes the
         odom -> base_footprint TF on hardware (see config/ekf_hw.yaml). It is
         also the only speed source of the cage: cv_lane_estimator_node reads
         /odometry/filtered, and without it C-03/C-04 are inactive. -->
    <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node" output="screen">
        <param from="$(find-pkg-share cobraflex)/config/ekf_hw.yaml"/>
    </node>

</launch>
