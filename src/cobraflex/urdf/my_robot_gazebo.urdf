<?xml version="1.0"?>
<robot name="cobraflex_robot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="$(find cobraflex)/urdf/robot.gazebo" />

    <xacro:include filename="inertial_macros.xacro" />

    <xacro:include filename="$(find cobraflex)/urdf/zed_macro.urdf.xacro" />
    
    <xacro:property name="chassis_length" value="0.228" />
    <xacro:property name="chassis_width" value="0.130" />
    <xacro:property name="chassis_height" value="0.060" />
    <xacro:property name="chassis_mass" value="2.0172" />

    <xacro:property name="body_length" value="0.228" />
    <xacro:property name="body_width" value="0.180" />
    <xacro:property name="body_height" value="0.100" />
    <xacro:property name="body_mass" value="0.8928" />
    
    <xacro:property name="wheel_radius" value="0.03725" /> 
    <xacro:property name="wheel_width" value="0.02" />
    
    <xacro:property name="wheel_off_x" value="0.060" /> 
    <xacro:property name="wheel_off_y" value="${(chassis_width/2) + (wheel_width/2) + 0.002}" /> 

    <!-- Sensor mounts of the V3 printed body (Inventor assembly
         "Car HW Prototype V3"), in base_footprint: x from the midpoint between
         the axles, z from the ground. The sensor joints subtract body_link_z,
         which is also the source of body_joint, so the sensor poses do not
         depend on the body geometry of this file.
           lidar_scan_*  origin of /scan: rotation axis of the RPLIDAR A2 at
                         the height of its laser plane, 30.8 mm above its base
           zed_mount_*   mounting point on the bottom face of the ZED Mini,
                         on the line of its two M2 threads
           zed_center_*  camera centre (mount + height/2 along the pitched z
                         axis); also the position of imu_link
           zed_pitch     cradle pitch, 15 deg nose down -->
    <xacro:property name="body_link_z" value="${wheel_radius + body_height/2 + chassis_height/2}" />
    <xacro:property name="lidar_scan_x" value="0.035" />
    <xacro:property name="lidar_scan_z" value="0.15305" />
    <xacro:property name="zed_mount_x" value="0.0848" />
    <xacro:property name="zed_mount_z" value="0.1195" />
    <xacro:property name="zed_center_x" value="0.0882" />
    <xacro:property name="zed_center_z" value="0.1323" />
    <xacro:property name="zed_pitch" value="0.2618" />

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>  
            </geometry>
            <material name="black" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}"/> 
    </joint>

    <link name="body_link">
        <!-- V3.4 printed body (Inventor assembly "Car HW Prototype V3"): floor
             following Full Plate_wheels, tapered and empty rear cable chamber and
             front-bay side fairings (bot_V3), powerbank cabin (top_V3) and its lid,
             LiDAR pedestal and ZED clamp in the open front bay, on the unchanged
             Full Plate_wheels with the lane-camera holder. Positions are the CAD
             positions in base_footprint, offset by body_link_z; the leaning walls
             are drawn as tilted boxes. -->

        <!-- Full Plate_wheels, top skin -->
        <visual>
            <origin xyz="0 0 ${0.10575 - body_link_z}" rpy="0 0 0"/>
            <geometry><box size="0.222 0.16 0.003"/></geometry>
            <material name="grey" />
        </visual>
        <!-- bot_V3 floor -->
        <visual>
            <origin xyz="-0.001 0 ${0.10875 - body_link_z}" rpy="0 0 0"/>
            <geometry><box size="0.22 0.16 0.003"/></geometry>
            <material name="grey" />
        </visual>
        <!-- cable chamber, rear wall -->
        <visual>
            <origin xyz="-0.1095 0 ${0.13875 - body_link_z}" rpy="0 0 0"/>
            <geometry><box size="0.003 0.126 0.057"/></geometry>
            <material name="grey" />
        </visual>
        <!-- cable chamber, front wall above the cable entry -->
        <visual>
            <origin xyz="-0.0171 0 ${0.15715 - body_link_z}" rpy="0 -0.1394 0"/>
            <geometry><box size="0.003 0.128 0.0204"/></geometry>
            <material name="grey" />
        </visual>
        <!-- cable chamber, left wall -->
        <visual>
            <origin xyz="-0.062 0.0661 ${0.13875 - body_link_z}" rpy="0.2276 0 0"/>
            <geometry><box size="0.098 0.003 0.0585"/></geometry>
            <material name="grey" />
        </visual>
        <!-- cable chamber, right wall -->
        <visual>
            <origin xyz="-0.062 -0.0661 ${0.13875 - body_link_z}" rpy="-0.2276 0 0"/>
            <geometry><box size="0.098 0.003 0.0585"/></geometry>
            <material name="grey" />
        </visual>
        <!-- front-bay fairing, left -->
        <visual>
            <origin xyz="0.044 0.0775 ${0.12765 - body_link_z}" rpy="0 0 0"/>
            <geometry><box size="0.106 0.003 0.0348"/></geometry>
            <material name="grey" />
        </visual>
        <!-- front-bay fairing, right -->
        <visual>
            <origin xyz="0.044 -0.0775 ${0.12765 - body_link_z}" rpy="0 0 0"/>
            <geometry><box size="0.106 0.003 0.0348"/></geometry>
            <material name="grey" />
        </visual>
        <!-- powerbank cabin (top_V3), floor -->
        <visual>
            <origin xyz="-0.015 0 ${0.16925 - body_link_z}" rpy="0 0 0"/>
            <geometry><box size="0.192 0.122 0.004"/></geometry>
            <material name="grey" />
        </visual>
        <!-- powerbank cabin, left flank -->
        <visual>
            <origin xyz="-0.01555 0.0516 ${0.19175 - body_link_z}" rpy="0.3218 0 0"/>
            <geometry><box size="0.183 0.0025 0.0432"/></geometry>
            <material name="grey" />
        </visual>
        <!-- powerbank cabin, right flank -->
        <visual>
            <origin xyz="-0.01555 -0.0516 ${0.19175 - body_link_z}" rpy="-0.3218 0 0"/>
            <geometry><box size="0.183 0.0025 0.0432"/></geometry>
            <material name="grey" />
        </visual>
        <!-- powerbank cabin, front wall -->
        <visual>
            <origin xyz="0.07485 0 ${0.19175 - body_link_z}" rpy="0 -0.1974 0"/>
            <geometry><box size="0.0025 0.1 0.0418"/></geometry>
            <material name="grey" />
        </visual>
        <!-- powerbank cabin, rear wall -->
        <visual>
            <origin xyz="-0.10594 0 ${0.19175 - body_link_z}" rpy="0 0.1543 0"/>
            <geometry><box size="0.0025 0.1 0.0416"/></geometry>
            <material name="grey" />
        </visual>
        <!-- cabin lid -->
        <visual>
            <origin xyz="-0.016 0 ${0.21375 - body_link_z}" rpy="0 0 0"/>
            <geometry><box size="0.176 0.092 0.003"/></geometry>
            <material name="grey" />
        </visual>
        <!-- LiDAR pedestal -->
        <visual>
            <origin xyz="0.035 0 ${0.11625 - body_link_z}" rpy="0 0 0"/>
            <geometry><cylinder radius="0.04" length="0.012"/></geometry>
            <material name="grey" />
        </visual>
        <!-- ZED cradle bed -->
        <visual>
            <origin xyz="0.09275 0 ${0.11527 - body_link_z}" rpy="0 ${zed_pitch} 0"/>
            <geometry><box size="0.0305 0.128 0.004"/></geometry>
            <material name="grey" />
        </visual>

        <!-- Collision: lower deck, cable chamber and powerbank cabin (two boxes
             following its taper). The front bay stays open, as on the printed body;
             the side fairings stay inside the track of the wheels. -->
        <!-- lower deck: Full Plate_wheels and floor -->
        <collision>
            <origin xyz="0.0075 0 ${0.09475 - body_link_z}" rpy="0 0 0"/>
            <geometry>
                <box size="0.237 0.16 0.031"/>
            </geometry>
        </collision>
        <!-- cable chamber: tapered rear box, as the box of equal volume -->
        <collision>
            <origin xyz="-0.06 0 ${0.13875 - body_link_z}" rpy="0 0 0"/>
            <geometry>
                <box size="0.102 0.1299 0.057"/>
            </geometry>
        </collision>
        <!-- powerbank cabin (top_V3), lower half -->
        <collision>
            <origin xyz="-0.01525 0 ${0.17850 - body_link_z}" rpy="0 0 0"/>
            <geometry>
                <box size="0.188 0.1145 0.0225"/>
            </geometry>
        </collision>
        <!-- powerbank cabin, upper half and lid -->
        <collision>
            <origin xyz="-0.01575 0 ${0.20250 - body_link_z}" rpy="0 0 0"/>
            <geometry>
                <box size="0.18 0.0995 0.0255"/>
            </geometry>
        </collision>

        <!-- ==== body_link inertia derived from CAD, not from a macro.
             inertial_box is not to be restored here: the box model spreads
             body_mass uniformly, whereas the deck is dominated by the 550 g
             powerbank, which the V3.4 body carries high, in the cabin over the
             cable chamber, with the ZED Mini and the lane camera low at the nose.

             Source: Inventor assembly "Car HW Prototype V3" (V3.4), integrated on
             the part meshes. Masses: Full Plate_wheels with the lane-camera holder
             at their weighed 91.3 g; bot_V3, the top_V3 cabin, its lid, the LiDAR
             pedestal, the ZED cradle and its cap at 0.539 g/cm3 (the density that
             reproduces the weighed PLA shells); powerbank 0.550, ZED Mini 0.060
             and lane camera 0.005 kg at their positions. CAD total 953.0 g.
             The tensor refers to the link CoG and is scaled to body_mass, which
             keeps the weighed budget until the printed shells are weighed. The
             same pipeline applied to the previous body reproduces its declared
             tensor within 3 %.

             CoG in base_footprint: (0.00784, -0.00011, 0.16761) m. The
             CAD +X axis is the vehicle forward axis (axle positions and sensor
             directions), so the products of inertia are declared. See
             assets/Mathematical Model/parameters.md 2.1. -->
        <inertial>
            <origin xyz="0.00784 -0.00011 ${0.16761 - body_link_z}" rpy="0 0 0"/>
            <mass value="${body_mass}" />
            <inertia ixx="0.00237140" ixy="0.00000544" ixz="0.00062313"
                     iyy="0.00425067" iyz="-0.00000222"
                     izz="0.00415922" />
        </inertial>
    </link>

    <joint name="body_joint" type="fixed">
        <parent link="base_link"/>
        <child link="body_link"/>
        <origin xyz="0 0 ${body_link_z - wheel_radius}"/>
    </joint>

    <xacro:macro name="left_wheel_link" params="prefix x_location y_location">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_location} ${y_location} -0.02" rpy="-${pi/2} 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="${wheel_width}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <gazebo reference="${prefix}_wheel">
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="right_wheel_link" params="prefix x_location y_location">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_location} ${y_location} -0.02" rpy="-${pi/2} 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="${wheel_width}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <gazebo reference="${prefix}_wheel">
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:left_wheel_link prefix="front_left" x_location="${wheel_off_x}" y_location="${wheel_off_y}" />
    <xacro:right_wheel_link prefix="front_right" x_location="${wheel_off_x}" y_location="-${wheel_off_y}" />
    
    <xacro:left_wheel_link prefix="rear_left" x_location="-${wheel_off_x}" y_location="${wheel_off_y}" />
    <xacro:right_wheel_link prefix="rear_right" x_location="-${wheel_off_x}" y_location="-${wheel_off_y}" />


    <gazebo reference="base_footprint">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    
    <gazebo reference="base_link">
        <material name="grey" />
    </gazebo>

    <link name="lidar_link">
        <!-- lidar_link is the origin of the scan, at the height of the optics; the
             A2 extends from 30.8 mm below to 10.2 mm above it, so collision and
             inertial are centred 10.3 mm below the link origin. -->
        <visual>
            <origin xyz="0 0 -0.0103" rpy="0 0 ${pi}"/>
            <geometry>
                <cylinder length="0.04" radius="0.0375"/>
            </geometry>
            <material name="blue" />
        </visual>
        <collision>
            <origin xyz="0 0 -0.0103"/>
            <geometry>
                <cylinder length="0.04" radius="0.0375"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.190" length="0.04" radius="0.0375">
            <origin xyz="0 0 -0.0103" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="body_link"/>
        <child link="lidar_link"/>
        <origin xyz="${lidar_scan_x} 0 ${lidar_scan_z - body_link_z}" rpy="0 0 ${pi}"/>
    </joint>

    <xacro:zed_camera name="zedm" model="zedm">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:zed_camera>

    <joint name="zedm_mount_joint" type="fixed">
        <parent link="body_link"/>
        <child link="zedm_camera_link"/>
        <origin xyz="${zed_mount_x} 0 ${zed_mount_z - body_link_z}" rpy="0 ${zed_pitch} 0"/>
    </joint>

    <link name="camera_link_lane">
        <visual>
            <origin xyz="0 0 0" rpy="0 -1 0"/>
            <geometry>
                <cylinder radius="0.005" length="0.002"/>
            </geometry>
            <material name="yellow" />
        </visual>
        <collision>
             <geometry>
                <cylinder radius="0.005" length="0.002"/>
            </geometry>
        </collision>
    </link>

    <joint name="camera_joint_lane" type="fixed">
        <parent link="body_link"/>
        <child link="camera_link_lane"/>
        <origin xyz="${body_length/2 + 0.01} 0 -0.03" rpy="0 0.30 0"/>
    </joint>

    <link name="camera_link_optical_lane"></link>

    <joint name="camera_optical_joint_lane" type="fixed">
        <parent link="camera_link_lane"/>
        <child link="camera_link_optical_lane"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="imu_link" />

    <joint name="imu_joint" type="fixed">
        <origin xyz="${zed_center_x} 0 ${zed_center_z - body_link_z}" rpy="0 ${zed_pitch} 0" />
        <parent link="body_link"/>
        <child link="imu_link" />
    </joint>

</robot>
