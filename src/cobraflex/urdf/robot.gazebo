            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <publish_tf>true</publish_tf>
        </plugin>

        <plugin 
            filename="ignition-gazebo-odometry-publisher-system" 
            name="ignition::gazebo::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <odom_publish_frequency>50</odom_publish_frequency>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <dimensions>2</dimensions>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_tf>true</publish_tf>
        </plugin>
-->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>front_left_wheel_joint</joint_name>
            <joint_name>front_right_wheel_joint</joint_name>
            <joint_name>rear_left_wheel_joint</joint_name>
            <joint_name>rear_right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <gazebo reference="imu_link">
        <sensor name="ZEDm IMU" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <visualize>true</visualize>
        <topic>imu</topic>
        <enable_metrics>true</enable_metrics>
        <gz_frame_id>imu_link</gz_frame_id>
        </sensor>
    </gazebo>

    <gazebo reference="lidar_link">
        <sensor name="RPLiDAR" type="gpu_lidar">
            <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <topic>scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                    <samples>4000</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14</min_angle>
                    <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.015</min>
                    <max>8.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
                <frame_id>/lidar_link</frame_id>
            </lidar>
        </sensor>
    </gazebo>

    <!-- ZED Mini front stereo pair, and the depth the real camera returns.
         Both eyes sit on the macro's left/right frames (63 mm baseline) and
         follow the zed-ros2 topic convention.

         The LEFT eye is an rgbd_camera, not a camera. That is not a shortcut
         around simulating stereo. The real ZED Mini never hands ROS two raw
         images to match: it hands over depth already computed on the GPU and
         registered to the left eye, which is also the frame the SDK expresses
         its point cloud and its tracking in. One RGBD sensor posed on that
         frame reproduces the SDK's OUTPUT; two mono cameras plus a stereo
         matcher in ROS would reproduce its ALGORITHM, at a cost the
         simulation cannot afford and with nothing gained sim-to-real. The
         render is not what changes - gz-sensors extracts the RGB image out of
         the very buffer it fills the depth from, so this is one pass either
         way, the same as the mono sensor it replaces.

         The RIGHT eye stays a plain camera. Nothing subscribes to it; it is
         kept so the render matches the two lenses that physically exist.
         Delete it if the scene ever needs that render pass back.

         FOV corrected to the real ZED Mini's 102 deg horizontal, which the
         comment that used to live here flagged as pending "if the scene
         camera is ever consumed". It now is. At 16:9 a pinhole with 102 deg
         horizontal comes out near 70 deg vertical against the real camera's
         57 - the 2.1 mm lens is not a pinhole and faking the difference buys
         nothing. The aspect ratio matters more than either figure, and 4:3
         was simply wrong here: every ZED Mini mode (HD1080, HD720, WVGA) is
         16:9.

         480x270 rather than the 640x360 that would mirror WVGA. The cost that
         drove this is not the render, it is the reprojection into a cloud
         downstream: depth_image_proc has no decimation parameter, so this
         resolution is the only knob for it. 640x360 costs about a third of a
         core and drags the real time factor to roughly 0.76. -->
    <gazebo reference="zedm_left_camera_frame">
        <sensor name="ZEDm Left Cam" type="rgbd_camera">
            <camera>
                <horizontal_fov>1.7802358</horizontal_fov>
                <image>
                    <width>480</width>
                    <height>270</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>15</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
                <!-- Labels image, depth_image AND camera_info, and all three
                     really are optical, so it is right for them. gz-sensors
                     stamps the sensor's own /points with it too, where it is
                     WRONG - which is why that topic is not bridged. The full
                     argument is in config/gz_bridge.yaml. -->
                <optical_frame_id>zedm_left_camera_frame_optical</optical_frame_id>
                <!-- No <camera_info_topic> on purpose: RgbdCameraSensor
                     hardcodes Topic() + "/camera_info" and ignores the tag
                     (gz-sensors8, RgbdCameraSensor.cc:252), unlike the plain
                     camera below. The prefix underneath yields exactly the
                     name the old mono sensor advertised. -->
            </camera>
            <always_on>1</always_on>
            <update_rate>20</update_rate>
            <visualize>true</visualize>
            <!-- A PREFIX, not a full topic: gz appends /image, /depth_image,
                 /points and /camera_info to it. The RGB stream is therefore
                 camera/left/image, no longer camera/left/image_raw. -->
            <topic>camera/left</topic>
        </sensor>
    </gazebo>

    <gazebo reference="zedm_right_camera_frame">
        <sensor name="ZEDm Right Cam" type="camera">
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>15</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
                <optical_frame_id>zedm_right_camera_frame_optical</optical_frame_id>
                <camera_info_topic>camera/right/camera_info</camera_info_topic>
            </camera>
            <always_on>1</always_on>
            <update_rate>20</update_rate>
            <visualize>true</visualize>
            <topic>camera/right/image_raw</topic>
        </sensor>
    </gazebo>

    <gazebo reference="camera_link_lane">
        <!-- Mirrors the real IMX219-160 as consumed by lane_keeper_node.py
             on HW (proc frames 640x360, effective hfov 90 deg, timer 20 Hz);
             capture is 1280x720@60 but only the processed stream matters. -->
        <sensor name="Lane Cam" type="camera">
            <camera>
                <horizontal_fov>1.5707963</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>360</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>15</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
                <optical_frame_id>camera_link_optical_lane</optical_frame_id>
                <camera_info_topic>camera/camera_info</camera_info_topic>
            </camera>
            <always_on>1</always_on>
            <update_rate>20</update_rate>
            <visualize>true</visualize>
            <topic>camera/image_raw_lane</topic>            
        </sensor>
    </gazebo>

</robot>