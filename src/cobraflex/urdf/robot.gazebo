            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <publish_tf>true</publish_tf>
        </plugin>

        <plugin 
            filename="ignition-gazebo-odometry-publisher-system" 
            name="ignition::gazebo::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <odom_publish_frequency>50</odom_publish_frequency>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <dimensions>2</dimensions>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_tf>true</publish_tf>
        </plugin>
-->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>front_left_wheel_joint</joint_name>
            <joint_name>front_right_wheel_joint</joint_name>
            <joint_name>rear_left_wheel_joint</joint_name>
            <joint_name>rear_right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <gazebo reference="imu_link">
        <sensor name="ZEDm IMU" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <visualize>true</visualize>
        <topic>imu</topic>
        <enable_metrics>true</enable_metrics>
        <gz_frame_id>imu_link</gz_frame_id>
        </sensor>
    </gazebo>

    <gazebo reference="lidar_link">
        <sensor name="RPLiDAR" type="gpu_lidar">
            <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <topic>scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                    <samples>4000</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14</min_angle>
                    <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.015</min>
                    <max>8.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
                <frame_id>/lidar_link</frame_id>
            </lidar>
        </sensor>
    </gazebo>

    <!-- ZED Mini front stereo pair and the depth output of the physical camera.
         Both cameras are placed on the left/right frames of the macro (63 mm
         baseline) and follow the zed-ros2 topic convention.

         The left camera is an rgbd_camera. The physical ZED Mini does not
         provide two raw images for stereo matching in ROS: it provides depth
         computed on the GPU and registered to the left camera, which is also
         the frame of its point cloud and tracking. One RGBD sensor on that
         frame reproduces the output of the SDK; two mono cameras with a ROS
         stereo matcher would reproduce its algorithm, at a computational cost
         the simulation cannot afford and without sim-to-real benefit. The
         rendering cost is unchanged: gz-sensors extracts the RGB image from
         the buffer that holds the depth, in a single pass.

         The right camera is a plain camera without subscribers, kept to
         represent the two physical lenses. It can be removed when its render
         pass is needed elsewhere.

         Horizontal FOV of 102 deg, as on the physical ZED Mini. At 16:9 a
         pinhole with 102 deg horizontal has about 70 deg vertical, against
         57 deg on the physical camera; the 2.1 mm lens is not a pinhole, and
         approximating the difference has no benefit. The aspect ratio is the
         more relevant parameter: all ZED Mini modes (HD1080, HD720, WVGA) are
         16:9.

         480x270 instead of the 640x360 of WVGA. The limiting cost is the
         downstream reprojection into a point cloud, not the rendering:
         depth_image_proc has no decimation parameter, so the resolution is
         the only setting. 640x360 uses about a third of a CPU core and
         reduces the real-time factor to about 0.76. -->
    <gazebo reference="zedm_left_camera_frame">
        <sensor name="ZEDm Left Cam" type="rgbd_camera">
            <camera>
                <horizontal_fov>1.7802358</horizontal_fov>
                <image>
                    <width>480</width>
                    <height>270</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>15</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
                <!-- Applies to image, depth_image and camera_info, which are
                     all optical. gz-sensors also stamps the /points output of
                     the sensor with this frame, which is incorrect for that
                     output; the topic is therefore not bridged (see
                     config/gz_bridge.yaml). -->
                <optical_frame_id>zedm_left_camera_frame_optical</optical_frame_id>
                <!-- No <camera_info_topic>: RgbdCameraSensor sets
                     Topic() + "/camera_info" and ignores the tag
                     (gz-sensors8, RgbdCameraSensor.cc:252), unlike the plain
                     camera below. The prefix below yields the topic name of
                     the former mono sensor. -->
            </camera>
            <always_on>1</always_on>
            <update_rate>20</update_rate>
            <visualize>true</visualize>
            <!-- Topic prefix, not a full topic: gz appends /image, /depth_image,
                 /points and /camera_info. The RGB stream is camera/left/image. -->
            <topic>camera/left</topic>
        </sensor>
    </gazebo>

    <gazebo reference="zedm_right_camera_frame">
        <sensor name="ZEDm Right Cam" type="camera">
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>15</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
                <optical_frame_id>zedm_right_camera_frame_optical</optical_frame_id>
                <camera_info_topic>camera/right/camera_info</camera_info_topic>
            </camera>
            <always_on>1</always_on>
            <update_rate>20</update_rate>
            <visualize>true</visualize>
            <topic>camera/right/image_raw</topic>
        </sensor>
    </gazebo>

    <gazebo reference="camera_link_lane">
        <!-- Models the IMX219-160 as consumed by lane_keeper_node.py on hardware
             (processed frames 640x360, effective hfov 90 deg, timer 20 Hz); the
             1280x720@60 capture is not relevant for parity. -->
        <sensor name="Lane Cam" type="camera">
            <camera>
                <horizontal_fov>1.5707963</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>360</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>15</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
                <optical_frame_id>camera_link_optical_lane</optical_frame_id>
                <camera_info_topic>camera/camera_info</camera_info_topic>
            </camera>
            <always_on>1</always_on>
            <update_rate>20</update_rate>
            <visualize>true</visualize>
            <topic>camera/image_raw_lane</topic>            
        </sensor>
    </gazebo>

</robot>