<?xml version="1.0"?>
<robot name="cobraflex_robot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="$(find cobraflex)/urdf/robot.gazebo" />
    <xacro:include filename="$(find cobraflex)/urdf/zed_descr.urdf.xacro"/>

    <xacro:include filename="inertial_macros.xacro" />

    <!-- ==== Mass budget. Measured total mass of the robot: 3.5 kg.
         The link masses below sum to this value, so that Gazebo simulates the
         vehicle on which the controllers are tuned:

             chassis   2.0172 kg   frame, 4 motors, driver board, motor
                                   battery, Jetson Orin Nano, wiring
             body      0.8928 kg   PLA shells 0.2778 + powerbank 0.550 +
                                   ZED Mini 0.060 + lane camera 0.005
             wheels    0.40   kg   4 x 0.10
             lidar     0.19   kg   RPLidar A2

             total     3.5000 kg

         The chassis/body split is derived from the weighed bill of materials
         in assets/Mathematical Model/parameters.md section 2.1. The Jetson is
         mounted on the chassis, not on the upper deck; the deck is therefore
         the lighter part despite carrying the 550 g powerbank.

         The mass budget is also stated in the root README and in
         parameters.md; all files are changed together. -->

    <xacro:property name="chassis_length" value="0.228" />
    <xacro:property name="chassis_width" value="0.130" />
    <xacro:property name="chassis_height" value="0.060" />
    <xacro:property name="chassis_mass" value="2.0172" />

    <xacro:property name="body_length" value="0.228" />
    <xacro:property name="body_width" value="0.180" />
    <xacro:property name="body_height" value="0.100" />
    <xacro:property name="body_mass" value="0.8928" />
    
    <xacro:property name="wheel_radius" value="0.03725" /> 
    <xacro:property name="wheel_width" value="0.02" />
    
    <xacro:property name="wheel_off_x" value="0.060" />
    <xacro:property name="wheel_off_y" value="${(chassis_width/2) + (wheel_width/2) + 0.002}" />

    <!-- ==== Visual materials. Colours match the parts of the physical robot. -->
    <material name="carbon">      <color rgba="0.34 0.35 0.39 1"/></material>
    <material name="dark_grey">   <color rgba="0.46 0.48 0.52 1"/></material>
    <material name="mid_grey">    <color rgba="0.64 0.66 0.70 1"/></material>
    <material name="alu">         <color rgba="0.82 0.84 0.87 1"/></material>
    <material name="tyre">        <color rgba="0.26 0.26 0.29 1"/></material>
    <material name="rim">         <color rgba="0.88 0.90 0.93 1"/></material>
    <material name="lipo">        <color rgba="0.90 0.26 0.16 1"/></material>
    <material name="pcb_green">   <color rgba="0.13 0.62 0.32 1"/></material>
    <material name="lidar_body">  <color rgba="0.32 0.36 0.44 1"/></material>
    <material name="lidar_head">  <color rgba="0.52 0.57 0.66 1"/></material>
    <material name="lens">        <color rgba="0.16 0.17 0.22 1"/></material>
    <material name="copper">      <color rgba="0.85 0.53 0.24 1"/></material>
    <material name="anodised">    <color rgba="0.16 0.45 0.82 1"/></material>

    <!-- base_footprint is the root of this description.
         robot_localization publishes odom -> <base_link_frame>, and
         robot_state_publisher publishes this tree from its root; if the two name
         different frames, one frame has two parents and the TF tree is invalid.
         config/ekf_hw.yaml uses base_footprint, ekf_gazebo.yaml and the Gazebo
         descriptions use it as root, and the Fixed Frame of every RViz
         configuration is base_footprint.

         The ZED is therefore attached to body_link (zed_mount_joint, below).
         A tree rooted at zed_camera_link is also consistent, but two_d_mode of
         the EKF would then fix the camera at z=0 (base_footprint at z=-0.13725)
         and move the velocity reference 0.11 m forward, adding an omega*0.11
         term to the speed read by the cage in curves (about +8 % at the
         deployed 0.22 m/s). -->
    <link name="base_footprint"/>

    <link name="base_link">
        <!-- main chassis plate -->
        <visual>
            <origin xyz="0 0 -0.024" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} 0.112 0.010"/>
            </geometry>
            <material name="carbon" />
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}"/>
    </joint>

    <!-- ==== base_link cosmetic sub-assemblies (see header note) ==== -->

    <!-- side rails (battery / ESC pods) -->
    <link name="viz_chassis_rails">
        <visual>
            <origin xyz="0 0.055 -0.004" rpy="0 0 0"/>
            <geometry>
                <box size="0.170 0.020 0.034"/>
            </geometry>
            <material name="dark_grey" />
        </visual>
        <visual>
            <origin xyz="0 -0.055 -0.004" rpy="0 0 0"/>
            <geometry>
                <box size="0.170 0.020 0.034"/>
            </geometry>
            <material name="dark_grey" />
        </visual>
    </link>
    <joint name="viz_chassis_rails_joint" type="fixed"><parent link="base_link"/><child link="viz_chassis_rails"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <!-- front + rear bumpers -->
    <link name="viz_bumpers">
        <visual>
            <origin xyz="0.108 0 -0.016" rpy="0 0 0"/>
            <geometry>
                <box size="0.022 0.124 0.020"/>
            </geometry>
            <material name="mid_grey" />
        </visual>
        <visual>
            <origin xyz="-0.109 0 -0.016" rpy="0 0 0"/>
            <geometry>
                <box size="0.020 0.116 0.020"/>
            </geometry>
            <material name="mid_grey" />
        </visual>
    </link>
    <joint name="viz_bumpers_joint" type="fixed"><parent link="base_link"/><child link="viz_bumpers"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <!-- Axle housings, driveshaft and the four body mounts. body_joint raises
         body_link by 0.080 m, which leaves a 17 mm gap between the electronics
         deck and the chassis rails; the mounts close this gap in RViz. They
         run from the top face of the chassis plate (z=-0.019) to the underside
         of the deck (z=+0.030): length 0.049, centred at z=+0.0055, at
         |y|=0.036 to clear the side rails (0.045..0.065) and |x|=0.078 to
         clear the servo, motor and driveshaft. The cylinder axis is Z, hence
         the rotations. -->
    <link name="viz_drivetrain">
        <visual>
            <origin xyz="${wheel_off_x} 0 -0.012" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="0.011" length="0.104"/>
            </geometry>
            <material name="alu" />
        </visual>
        <visual>
            <origin xyz="-${wheel_off_x} 0 -0.012" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="0.011" length="0.104"/>
            </geometry>
            <material name="alu" />
        </visual>
        <visual>
            <origin xyz="0 0 -0.012" rpy="0 ${pi/2} 0"/>
            <geometry>
                <cylinder radius="0.006" length="0.108"/>
            </geometry>
            <material name="alu" />
        </visual>
        <visual>
            <origin xyz="0.078 0.036 0.0055" rpy="0 0 0"/>
            <geometry><cylinder radius="0.006" length="0.049"/></geometry>
            <material name="alu" />
        </visual>
        <visual>
            <origin xyz="0.078 -0.036 0.0055" rpy="0 0 0"/>
            <geometry><cylinder radius="0.006" length="0.049"/></geometry>
            <material name="alu" />
        </visual>
        <visual>
            <origin xyz="-0.078 0.036 0.0055" rpy="0 0 0"/>
            <geometry><cylinder radius="0.006" length="0.049"/></geometry>
            <material name="alu" />
        </visual>
        <visual>
            <origin xyz="-0.078 -0.036 0.0055" rpy="0 0 0"/>
            <geometry><cylinder radius="0.006" length="0.049"/></geometry>
            <material name="alu" />
        </visual>
    </link>
    <joint name="viz_drivetrain_joint" type="fixed"><parent link="base_link"/><child link="viz_drivetrain"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <!-- motor can, transversely mounted ahead of the rear axle -->
    <link name="viz_motor">
        <visual>
            <origin xyz="-0.030 0.020 0.002" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="0.0165" length="0.048"/>
            </geometry>
            <material name="copper" />
        </visual>
    </link>
    <joint name="viz_motor_joint" type="fixed"><parent link="base_link"/><child link="viz_motor"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <!-- steering servo, ahead of the front axle -->
    <link name="viz_servo">
        <visual>
            <origin xyz="0.082 -0.018 0.000" rpy="0 0 0"/>
            <geometry>
                <box size="0.040 0.021 0.037"/>
            </geometry>
            <material name="anodised" />
        </visual>
    </link>
    <joint name="viz_servo_joint" type="fixed"><parent link="base_link"/><child link="viz_servo"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <link name="body_link">
        <!-- Electronics deck: two plates on standoffs carrying the Jetson and
             the LiPo, which occupy this volume on the physical robot. The side
             skirts keep the 0.180 m width of the body. -->

        <!-- lower deck plate -->
        <visual>
            <origin xyz="0 0 -0.046" rpy="0 0 0"/>
            <geometry>
                <box size="${body_length} 0.176 0.008"/>
            </geometry>
            <material name="carbon" />
        </visual>

        <!-- upper deck plate (the lidar mounts on this) -->
        <visual>
            <origin xyz="0 0 0.047" rpy="0 0 0"/>
            <geometry>
                <box size="0.150 0.140 0.006"/>
            </geometry>
            <material name="carbon" />
        </visual>

        <!-- ===== SENSOR MAST =====================================
             The three front sensors are children of body_link at fixed
             offsets that must not change (the 0.3 rad pitch and mount height
             of the lane camera feed the IPM in camera_geometry.py). These
             visuals represent the supporting structure ahead of the deck; no
             sensor frame is moved:

               nose shelf   deck front edge -> under camera_link_lane (x 0.124)
               mast         shelf -> ZED height, seated 1 mm into the deck
               cross-bar    top plate the ZED body (z 0.020..0.047) rests on,
                            in viz_mast_plate below because it is anodised

             The mast is placed at x 0.099..0.109, 2 mm clear of the LiPo
             pack, which ends at x=0.097. -->
        <visual>
            <origin xyz="0.116 0 -0.0445" rpy="0 0 0"/>
            <geometry><box size="0.026 0.046 0.007"/></geometry>
            <material name="carbon" />
        </visual>
        <visual>
            <origin xyz="0.104 0 -0.011" rpy="0 0 0"/>
            <geometry><box size="0.010 0.056 0.064"/></geometry>
            <material name="carbon" />
        </visual>

        <collision>
            <origin xyz="0 0 ${body_height/2 + wheel_radius}" rpy="0 0 0"/>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}"/>
            </geometry>
        </collision>

        <!-- ==== body_link inertia derived from CAD, not from a macro.
             inertial_box is not to be restored here. The box model distributes
             body_mass uniformly over 0.228 x 0.180 x 0.100, whereas the real
             deck is dominated by the 550 g powerbank, compact and low in the
             centre shell; the box overestimates every moment by 35-54 %:

                        macro          CAD
                 ixx    0.00315456     0.00206253    -34.6 %
                 iyy    0.00461161     0.00210198    -54.4 %
                 izz    0.00627817     0.00359719    -42.7 %

             Source: Inventor assembly with every component at its weighed
             density (composite 0.908 g/cm3; PLA shells at 0.539 g/cm3, which
             reproduces their measured 277.8 g). The tensor refers to the link
             CoG and is scaled from the CAD mass of 898.7 g to body_mass.

             The CoG lies 12.6 mm below the box centre (52.6 mm below the
             LiDAR, which lidar_joint places at 0.090); hence the origin
             0.037415 instead of body_height/2.

             The CAD reports ixz = 1.26e-04 (6 % of ixx; the sensor mast is
             forward and high, the powerbank low). It is set to zero until the
             +X direction of the CAD is confirmed: the macro cannot represent
             it, and a sign error would couple pitch in the wrong direction,
             which is worse than omitting the term.

             base_link, the wheels and the LiDAR were checked with the same
             method and are within 5-6 % of their macro values; they keep the
             macros. See assets/Mathematical Model/parameters.md 2.1. -->
        <inertial>
            <origin xyz="0 0 0.037415" rpy="0 0 0"/>
            <mass value="${body_mass}" />
            <inertia ixx="0.00206253" ixy="0.0" ixz="0.0"
                     iyy="0.00210198" iyz="0.0"
                     izz="0.00359719" />
        </inertial>
    </link>

    <joint name="body_joint" type="fixed">
        <parent link="base_link"/>
        <child link="body_link"/>
        <origin xyz="0 0 ${body_height/2 + chassis_height/2}"/>
    </joint>

    <!-- ==== body_link cosmetic sub-assemblies (see header note) ==== -->

    <!-- Jetson enclosure -->
    <link name="viz_jetson">
        <visual>
            <origin xyz="-0.028 0 -0.020" rpy="0 0 0"/>
            <geometry>
                <box size="0.105 0.092 0.043"/>
            </geometry>
            <material name="dark_grey" />
        </visual>
    </link>
    <joint name="viz_jetson_joint" type="fixed"><parent link="body_link"/><child link="viz_jetson"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <!-- Jetson heatsink + the four standoffs between the deck plates -->
    <link name="viz_deck_hardware">
        <visual>
            <origin xyz="-0.028 0 0.008" rpy="0 0 0"/>
            <geometry>
                <box size="0.082 0.082 0.014"/>
            </geometry>
            <material name="alu" />
        </visual>
        <visual>
            <origin xyz="0.066 0.062 0.001" rpy="0 0 0"/>
            <geometry><cylinder radius="0.0035" length="0.086"/></geometry>
            <material name="alu" />
        </visual>
        <visual>
            <origin xyz="0.066 -0.062 0.001" rpy="0 0 0"/>
            <geometry><cylinder radius="0.0035" length="0.086"/></geometry>
            <material name="alu" />
        </visual>
        <visual>
            <origin xyz="-0.066 0.062 0.001" rpy="0 0 0"/>
            <geometry><cylinder radius="0.0035" length="0.086"/></geometry>
            <material name="alu" />
        </visual>
        <visual>
            <origin xyz="-0.066 -0.062 0.001" rpy="0 0 0"/>
            <geometry><cylinder radius="0.0035" length="0.086"/></geometry>
            <material name="alu" />
        </visual>
    </link>
    <joint name="viz_deck_hardware_joint" type="fixed"><parent link="body_link"/><child link="viz_deck_hardware"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <!-- LiPo pack -->
    <link name="viz_lipo">
        <visual>
            <origin xyz="0.058 0 -0.028" rpy="0 0 0"/>
            <geometry>
                <box size="0.078 0.046 0.028"/>
            </geometry>
            <material name="lipo" />
        </visual>
    </link>
    <joint name="viz_lipo_joint" type="fixed"><parent link="body_link"/><child link="viz_lipo"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <!-- Side skirts: 0.180 m body width. Lowered by 8 mm
         (z -0.030 -> -0.034, height 0.040 -> 0.048), so that the lower edge
         reaches base_link z=+0.022 and meets the chassis rails. The wheels
         reach base_link z=+0.01725 and overlap the skirts in y; this leaves
         4.75 mm of wheel-arch clearance. -->
    <link name="viz_skirts">
        <visual>
            <origin xyz="0 0.086 -0.034" rpy="0 0 0"/>
            <geometry>
                <box size="0.190 0.008 0.048"/>
            </geometry>
            <material name="mid_grey" />
        </visual>
        <visual>
            <origin xyz="0 -0.086 -0.034" rpy="0 0 0"/>
            <geometry>
                <box size="0.190 0.008 0.048"/>
            </geometry>
            <material name="mid_grey" />
        </visual>
    </link>
    <joint name="viz_skirts_joint" type="fixed"><parent link="body_link"/><child link="viz_skirts"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <!-- camera mount plate on top of the mast; the ZED body sits on it -->
    <link name="viz_mast_plate">
        <visual>
            <origin xyz="0.104 0 0.019" rpy="0 0 0"/>
            <geometry><box size="0.014 0.100 0.008"/></geometry>
            <material name="anodised" />
        </visual>
    </link>
    <joint name="viz_mast_plate_joint" type="fixed"><parent link="body_link"/><child link="viz_mast_plate"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <xacro:macro name="left_wheel_link" params="prefix x_location y_location">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_location} ${y_location} -0.02" rpy="-${pi/2} 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="${prefix}_wheel">
            <!-- Tyre. The Z axis of the link is the axle (the joint rotates it
                 by -pi/2 about X). The visual width is the real 0.0275 m; the
                 collision uses ${wheel_width}. -->
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="0.0275"/>
                </geometry>
                <material name="tyre" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="${wheel_width}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <!-- Rim and hub nut, separate from the tyre for distinct colours in
             RViz. Both share the axle axis; the hub uses the rim material,
             since at r=0.0075 a separate material is not visible. -->
        <link name="viz_${prefix}_rim">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.0245" length="0.0295"/>
                </geometry>
                <material name="rim" />
            </visual>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.0075" length="0.0335"/>
                </geometry>
                <material name="rim" />
            </visual>
        </link>
        <joint name="viz_${prefix}_rim_joint" type="fixed"><parent link="${prefix}_wheel"/><child link="viz_${prefix}_rim"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

        <gazebo reference="${prefix}_wheel">
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="right_wheel_link" params="prefix x_location y_location">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_location} ${y_location} -0.02" rpy="-${pi/2} 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="${prefix}_wheel">
            <!-- Tyre. The Z axis of the link is the axle (the joint rotates it
                 by -pi/2 about X). The visual width is the real 0.0275 m; the
                 collision uses ${wheel_width}. -->
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="0.0275"/>
                </geometry>
                <material name="tyre" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="${wheel_width}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <!-- Rim and hub nut, separate from the tyre for distinct colours in
             RViz. Both share the axle axis; the hub uses the rim material,
             since at r=0.0075 a separate material is not visible. -->
        <link name="viz_${prefix}_rim">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.0245" length="0.0295"/>
                </geometry>
                <material name="rim" />
            </visual>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.0075" length="0.0335"/>
                </geometry>
                <material name="rim" />
            </visual>
        </link>
        <joint name="viz_${prefix}_rim_joint" type="fixed"><parent link="${prefix}_wheel"/><child link="viz_${prefix}_rim"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

        <gazebo reference="${prefix}_wheel">
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:left_wheel_link prefix="front_left" x_location="${wheel_off_x}" y_location="${wheel_off_y}" />
    <xacro:right_wheel_link prefix="front_right" x_location="${wheel_off_x}" y_location="-${wheel_off_y}" />
    
    <xacro:left_wheel_link prefix="rear_left" x_location="-${wheel_off_x}" y_location="${wheel_off_y}" />
    <xacro:right_wheel_link prefix="rear_right" x_location="-${wheel_off_x}" y_location="-${wheel_off_y}" />


    <gazebo reference="base_footprint">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    
    <gazebo reference="base_link">
        <material name="grey" />
    </gazebo>

    <link name="lidar_link">
        <!-- RPLIDAR A2M8: base ring, rotating head, cap and laser window, on
             three standoffs to the deck.
             The visual is at the link origin, consistent with <collision>.
             The joint, the collision and the lidar_link frame determine the
             sensor pose; the visual does not. -->

        <!-- base ring -->
        <visual>
            <origin xyz="0 0 -0.013" rpy="0 0 0"/>
            <geometry><cylinder length="0.014" radius="0.0375"/></geometry>
            <material name="lidar_body" />
        </visual>
        <!-- top cap -->
        <visual>
            <origin xyz="0 0 0.014" rpy="0 0 0"/>
            <geometry><cylinder length="0.012" radius="0.0375"/></geometry>
            <material name="lidar_body" />
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.04" radius="0.0375"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.190" length="0.04" radius="0.0375">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="body_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 ${body_height/2 + 0.04}" rpy="0 0 ${pi}"/>
    </joint>

    <!-- ==== lidar_link cosmetic sub-assemblies (see header note) ==== -->

    <!-- rotating head + laser aperture -->
    <link name="viz_lidar_head">
        <visual>
            <origin xyz="0 0 0.001" rpy="0 0 0"/>
            <geometry><cylinder length="0.018" radius="0.0350"/></geometry>
            <material name="lidar_head" />
        </visual>
    </link>
    <joint name="viz_lidar_head_joint" type="fixed"><parent link="lidar_link"/><child link="viz_lidar_head"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <link name="viz_lidar_aperture">
        <visual>
            <origin xyz="0.030 0 0.001" rpy="0 0 0"/>
            <geometry><box size="0.012 0.024 0.013"/></geometry>
            <material name="lens" />
        </visual>
    </link>
    <joint name="viz_lidar_aperture_joint" type="fixed"><parent link="lidar_link"/><child link="viz_lidar_aperture"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <!-- three standoffs bridging the 20 mm gap down to the upper deck -->
    <link name="viz_lidar_standoffs">
        <visual>
            <origin xyz="0.028 0 -0.030" rpy="0 0 0"/>
            <geometry><cylinder radius="0.003" length="0.020"/></geometry>
            <material name="alu" />
        </visual>
        <visual>
            <origin xyz="-0.014 0.02425 -0.030" rpy="0 0 0"/>
            <geometry><cylinder radius="0.003" length="0.020"/></geometry>
            <material name="alu" />
        </visual>
        <visual>
            <origin xyz="-0.014 -0.02425 -0.030" rpy="0 0 0"/>
            <geometry><cylinder radius="0.003" length="0.020"/></geometry>
            <material name="alu" />
        </visual>
    </link>
    <joint name="viz_lidar_standoffs_joint" type="fixed"><parent link="lidar_link"/><child link="viz_lidar_standoffs"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <!-- ZED Mini mount. zed_camera_link is the root link of the zed_camera macro
         (zed_descr.urdf.xacro); this joint attaches the ZED subtree to the
         robot. Without it, base_footprint and zed_camera_link are two separate
         roots and robot_state_publisher publishes an incomplete tree.

         Offset: zed_camera_link is 0.11 m ahead of and 0.13725 m above
         base_footprint. body_link is 0.11725 m above it (base_joint 0.03725 +
         body_joint 0.08), which gives (0.11, 0, 0.02) from body_link.

         camera_link below is at body_length/2 = 0.114 in x, 4 mm from
         zed_camera_link. The ZED keeps 0.11, the geometry of the recorded runs;
         the camera is not moved to reconcile the two. Open item: measure the
         physical mount and correct both (docs/17 §2 [VERIFY]). -->
    <joint name="zed_mount_joint" type="fixed">
        <parent link="body_link"/>
        <child link="zed_camera_link"/>
        <origin xyz="0.11 0 0.02" rpy="0 0 0"/>
    </joint>

    <link name="camera_link">
        <!-- Former mono-camera frame, without visual: it lies at body_link
             (0.114, 0, 0.02), inside the ZED Mini body drawn by
             zed_camera_link, and no sensor in robot.gazebo references it.
             Link, joint and collision are kept, since the RViz configurations
             list this frame. -->
        <collision>
             <geometry>
                <box size="0.01 0.1 0.02"/>
            </geometry>
        </collision>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="body_link"/>
        <child link="camera_link"/>
        <origin xyz="${body_length/2} 0 0.02" rpy="0 0 0"/>
    </joint>

    <link name="camera_link_optical"></link>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>


    <link name="camera_link_lane">
        <!-- Lane camera read by the RL policy (IMX219 CSI module): green PCB,
             lens barrel along +X. The joint pitches the link 0.30 rad down;
             the IPM in camera_geometry.py depends on this pitch and on the
             mount height, which must not change. -->
        <visual>
            <origin xyz="-0.002 0 0" rpy="0 0 0"/>
            <geometry><box size="0.004 0.025 0.024"/></geometry>
            <material name="pcb_green" />
        </visual>
        <collision>
             <geometry>
                <box size="0.005 0.02 0.02"/>
            </geometry>
        </collision>
    </link>

    <joint name="camera_joint_lane" type="fixed">
        <parent link="body_link"/>
        <child link="camera_link_lane"/>
        <origin xyz="${body_length/2 + 0.01} 0 -0.03" rpy="0 0.3 0"/>
    </joint>

    <!-- lens barrel + retaining ring of the lane camera -->
    <link name="viz_lane_cam_lens">
        <visual>
            <origin xyz="0.004 0 0" rpy="0 ${pi/2} 0"/>
            <geometry><cylinder radius="0.0055" length="0.009"/></geometry>
            <material name="lens" />
        </visual>
        <visual>
            <origin xyz="0.0090 0 0" rpy="0 ${pi/2} 0"/>
            <geometry><cylinder radius="0.0034" length="0.001"/></geometry>
            <material name="lens" />
        </visual>
    </link>
    <joint name="viz_lane_cam_lens_joint" type="fixed"><parent link="camera_link_lane"/><child link="viz_lane_cam_lens"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

    <link name="camera_link_optical_lane"></link>

    <joint name="camera_optical_joint_lane" type="fixed">
        <parent link="camera_link_lane"/>
        <child link="camera_link_optical_lane"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="imu_link" />

    <joint name="imu_joint" type="fixed">
        <origin xyz="${body_length/2 - 0.04} 0 0.02" rpy="0 0 0" />
        <parent link="body_link"/>
        <child link="imu_link" />
    </joint>

</robot>