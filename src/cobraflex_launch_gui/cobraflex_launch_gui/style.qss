* { font-family: ${font_ui}; font-size: ${fs_body}; }

/* "Carrocería" theme: the colours of the robot body. Colour and font tokens
   (c_*, font_*) come from theme.py and size tokens (fs_*, ctl_*) from
   density.py; density.load_style fills both. Signal red is the one accent;
   green marks Run; black marks the selection. Any other colour marks an
   abnormal state, next to a word that names it. */

QMainWindow { background: ${c_lid}; }
QWidget#root { background: ${c_lid}; color: ${c_tyre}; }

QFrame#hdr { background: ${c_lid}; border-bottom: 1px solid ${c_line}; }
QLabel#hdrEyebrow { font-size: ${fs_tiny}; font-weight: 700; color: ${c_chassis}; }
QLabel#hdrTitle { font-size: ${fs_title}; font-weight: 700; color: ${c_tyre}; }
QFrame#hdrRunning { background: ${c_shell}; border: 1px solid ${c_line}; border-radius: 12px; }
QLabel#hdrRunningText { color: ${c_tyre}; font-size: ${fs_small}; font-weight: 600; }

QLabel#modeBadge {
    background: ${c_amber_bg}; color: ${c_amber};
    border: 1px solid ${c_amber}; border-radius: 4px;
    font-size: ${fs_tiny}; font-weight: 700;
    padding: 2px 7px;
}

QFrame#tabBar { background: ${c_lid}; border-bottom: 1px solid ${c_line}; }
QPushButton#tab {
    background: transparent; color: ${c_chassis};
    border: none; border-bottom: 3px solid transparent;
    padding: 10px 16px; font-size: ${fs_body}; font-weight: 600;
    margin: 0;
}
QPushButton#tab:hover { color: ${c_tyre}; }
QPushButton#tab:checked { color: ${c_tyre}; border-bottom: 3px solid ${c_signal}; }

QFrame#filterBar { background: ${c_lid}; border-bottom: 1px solid ${c_line}; }
QFrame#searchWrap { background: ${c_shell}; border: 1px solid ${c_line_strong}; border-radius: 6px; }
QFrame#searchWrap[focused="true"] { border-color: ${c_tyre}; }
QLineEdit#searchInput { background: transparent; border: none; color: ${c_tyre}; font-size: ${fs_body}; }

QPushButton#chip {
    background: ${c_shell}; color: ${c_chassis};
    border: 1px solid ${c_line_strong}; border-radius: 14px;
    padding: 5px 14px; font-size: ${fs_meta}; font-weight: 600;
}
QPushButton#chip:hover { color: ${c_tyre}; border-color: ${c_tyre}; }
QPushButton#chip:checked { background: ${c_tyre}; color: ${c_on_dark}; border-color: ${c_tyre}; }
QPushButton#chip:checked:hover { background: ${c_chassis}; border-color: ${c_chassis}; }

QLabel#countPill {
    background: ${c_shell}; color: ${c_chassis};
    border: 1px solid ${c_line}; border-radius: 14px;
    padding: 5px 14px; font-size: ${fs_small}; font-weight: 600;
}

QLabel#sectionLabel { color: ${c_chassis}; font-size: ${fs_tiny}; font-weight: 700; }
QLabel#sectionCount {
    color: ${c_chassis}; font-size: ${fs_tiny}; font-weight: 700;
    background: ${c_well}; border: 1px solid ${c_line};
    border-radius: 9px; padding: 1px 8px;
}
QFrame#sectionRule { background: ${c_line}; border: none; max-height: 1px; }

/* Cards: white shell on the grey lid. A running launch needs no colour; a
   failed one is tinted red and says "failed". The selection is a black edge. */
QFrame[role="card"] { background: ${c_shell}; border: 1px solid ${c_line}; border-radius: 6px; }
QFrame[role="card"]:hover { border-color: ${c_line_strong}; }
QFrame[role="card"][failed="true"] { background: ${c_signal_bg}; border-color: ${c_signal}; }
QFrame[role="card"][expanded="true"] { border-color: ${c_line_strong}; }
QFrame[role="card"][selected="true"] { border-color: ${c_tyre}; }

QPushButton#cardStar {
    background: transparent; border: none; padding: 0 2px;
    color: ${c_tyre}; font-size: ${fs_body};
    min-width: ${star_min}; max-width: ${star_max};
}

QPushButton#expandBtn {
    background: ${c_shell}; border: 1px solid ${c_line_strong}; border-radius: 4px;
    color: ${c_chassis}; padding: 0;
    min-width: ${expand}; max-width: ${expand}; min-height: ${expand}; max-height: ${expand};
    font-size: ${fs_body}; font-weight: 700;
}
QPushButton#expandBtn:hover { border-color: ${c_tyre}; }
QPushButton#expandBtn[open="true"] { background: ${c_tyre}; border-color: ${c_tyre}; }

QLabel#cardArgsBadge {
    color: ${c_chassis}; background: ${c_well};
    border: 1px solid ${c_line}; border-radius: 9px;
    padding: 1px 8px; font-size: ${fs_tiny}; font-weight: 700;
    font-family: ${font_mono};
}

QFrame#expandContainer { background: transparent; }
QFrame#expandable {
    background: ${c_shell_alt};
    border-top: 1px solid ${c_line};
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}
QLabel#expandLabel { color: ${c_chassis}; font-size: ${fs_tiny}; font-weight: 700; }
QLabel#cmdBox {
    background: ${c_code_bg}; border: 1px solid ${c_code_bg};
    border-radius: 6px; padding: 10px 12px;
    color: ${c_code_fg}; font-size: ${fs_small};
    font-family: ${font_mono};
}

QFrame#argRow { background: transparent; border-radius: 5px; }
QFrame#argRow:hover { background: ${c_well}; }
QLabel#argKey {
    color: ${c_tyre}; font-size: ${fs_small}; font-weight: 600;
    font-family: ${font_mono};
}
QLabel#argMod { color: ${c_tyre}; font-weight: 700; font-size: ${fs_body}; }

QFrame#boolSeg {
    background: ${c_well}; border: 1px solid ${c_line_strong}; border-radius: 6px;
}
QPushButton#boolSegBtn {
    background: transparent; border: none; color: ${c_chassis};
    padding: 3px 12px; font-size: ${fs_small}; min-height: ${ctl_s};
    font-family: ${font_mono};
}
QPushButton#boolSegBtn:hover { color: ${c_tyre}; }
QPushButton#boolSegBtn:checked {
    background: ${c_tyre}; color: ${c_on_dark}; border-radius: 4px; font-weight: 700;
}

QComboBox#argEnum {
    background: ${c_shell}; border: 1px solid ${c_line_strong}; border-radius: 6px;
    color: ${c_tyre}; padding: 3px 10px; font-size: ${fs_small};
    min-height: ${ctl_s};
    font-family: ${font_mono};
}
QComboBox#argEnum:hover { border-color: ${c_tyre}; }
QComboBox#argEnum::drop-down { border: none; width: 18px; }
QComboBox#argEnum QAbstractItemView {
    background: ${c_shell}; border: 1px solid ${c_line_strong};
    color: ${c_tyre}; selection-background-color: ${c_tyre};
    selection-color: ${c_on_dark};
}

QLineEdit#argText {
    background: ${c_shell}; border: 1px solid ${c_line_strong}; border-radius: 6px;
    color: ${c_tyre}; padding: 3px 10px; font-size: ${fs_small};
    min-height: ${ctl_s};
    font-family: ${font_mono};
}
QLineEdit#argText:focus { border-color: ${c_tyre}; }

QPushButton#presetPill {
    background: ${c_shell}; color: ${c_tyre};
    border: 1px solid ${c_line_strong}; border-radius: 13px;
    padding: 4px 14px; font-size: ${fs_small}; font-weight: 600;
}
QPushButton#presetPill:hover { border-color: ${c_tyre}; }
QPushButton#presetPill:pressed { background: ${c_tyre}; color: ${c_on_dark}; }
QPushButton#presetSave {
    background: transparent; color: ${c_chassis};
    border: 1px dashed ${c_line_strong}; border-radius: 13px;
    padding: 4px 12px; font-size: ${fs_small}; font-weight: 600;
}
QPushButton#presetSave:hover { border-color: ${c_tyre}; color: ${c_tyre}; }

/* The name of the launch is the main text: hierarchy by size and weight. */
QLabel#cardPkg { color: ${c_chassis}; font-size: ${fs_body}; font-weight: 600; }
QLabel#cardSlash { color: ${c_faint}; font-size: ${fs_body}; }
QLabel#cardName { color: ${c_tyre}; font-size: ${fs_body}; font-weight: 700; }
QLabel#cardFmt { color: ${c_muted}; font-size: ${fs_tiny}; font-weight: 700; }
QLabel#cardDesc { color: ${c_chassis}; font-size: ${fs_meta}; }
QLabel#cardErrSnippet {
    color: ${c_signal}; font-size: ${fs_small};
    font-family: ${font_mono};
    background: ${c_shell}; border-left: 3px solid ${c_signal};
    padding: 4px 8px; border-radius: 3px;
}
QLabel#statusRunning { color: ${c_tyre}; font-size: ${fs_small}; font-weight: 700; }
QLabel#statusStopped { color: ${c_muted}; font-size: ${fs_small}; }
QLabel#statusFailed { color: ${c_signal}; font-size: ${fs_small}; font-weight: 700; }
QLabel#metaSep { color: ${c_faint}; font-size: ${fs_small}; }
QLabel#metaMono {
    color: ${c_chassis}; font-size: ${fs_small};
    font-family: ${font_mono};
}

/* State dots; running and stopping launches show the track of icons.TrackGlyph. */
QFrame#dotGrey { background: transparent; border: 2px solid ${c_faint}; border-radius: 4px; }
QFrame#dotRed { background: ${c_signal}; border: none; border-radius: 4px; }
QFrame#dotRedHalo { background: ${c_signal_bg}; border: none; border-radius: 7px; }

/* Actions: green starts, red stops, the rest is neutral. */
QPushButton#btnRun {
    background: ${c_go}; color: ${c_on_dark};
    border: 1px solid ${c_go}; border-radius: 6px;
    padding: 0 11px; font-size: ${fs_meta}; font-weight: 700; min-height: ${ctl_l};
}
QPushButton#btnRun:hover { background: ${c_go_dark}; border-color: ${c_go_dark}; }
QPushButton#btnRun:disabled { background: ${c_well}; color: ${c_faint}; border-color: ${c_line}; }

QPushButton#btnRetry {
    background: ${c_go}; color: ${c_on_dark};
    border: 1px solid ${c_go}; border-radius: 6px;
    padding: 0 11px; font-size: ${fs_meta}; font-weight: 700; min-height: ${ctl_l};
}
QPushButton#btnRetry:hover { background: ${c_go_dark}; border-color: ${c_go_dark}; }

QPushButton#btnRestart {
    background: ${c_shell}; color: ${c_tyre};
    border: 1px solid ${c_line_strong}; border-radius: 6px;
    padding: 0 11px; font-size: ${fs_meta}; font-weight: 700; min-height: ${ctl_l};
}
QPushButton#btnRestart:hover { border-color: ${c_tyre}; }
QPushButton#btnRestart:disabled { color: ${c_faint}; border-color: ${c_line}; }

QPushButton#btnStopAll {
    background: ${c_shell}; color: ${c_signal};
    border: 1px solid ${c_signal}; border-radius: 13px;
    padding: 5px 14px; font-size: ${fs_small}; font-weight: 700;
}
QPushButton#btnStopAll:hover { background: ${c_signal_bg}; }

QPushButton#btnStop {
    background: ${c_signal}; color: ${c_on_dark};
    border: 1px solid ${c_signal}; border-radius: 6px;
    padding: 0 11px; font-size: ${fs_meta}; font-weight: 700; min-height: ${ctl_l};
}
QPushButton#btnStop:hover { background: ${c_signal_dark}; border-color: ${c_signal_dark}; }
QPushButton#btnStop:disabled { background: ${c_well}; color: ${c_faint}; border-color: ${c_line}; }

QPushButton#btnLogs {
    background: ${c_shell}; color: ${c_tyre};
    border: 1px solid ${c_line_strong}; border-radius: 6px;
    padding: 0 11px; font-size: ${fs_meta}; font-weight: 600; min-height: ${ctl_l};
}
QPushButton#btnLogs:hover { border-color: ${c_tyre}; }

QLabel#empty {
    color: ${c_muted}; font-size: ${fs_meta};
    border: 1px dashed ${c_line_strong}; border-radius: 8px;
    padding: 32px;
}

/* Logs: a black panel, like the terminal it replaces. */
QFrame#logsPanel { background: ${c_lid}; border-top: 1px solid ${c_line}; }
QLabel#logsKey { color: ${c_chassis}; font-size: ${fs_tiny}; font-weight: 700; }
QLabel#logsSep { color: ${c_faint}; font-size: ${fs_small}; }
QLabel#logsSubject {
    color: ${c_tyre}; font-size: ${fs_small}; font-weight: 600;
    font-family: ${font_mono};
}
QFrame#logsLive { background: ${c_shell}; border: 1px solid ${c_line}; border-radius: 10px; }
QLabel#logsLiveText { color: ${c_tyre}; font-size: ${fs_tiny}; font-weight: 700; }

QPushButton[logLevel] {
    background: ${c_shell}; color: ${c_chassis};
    border: 1px solid ${c_line_strong}; border-radius: 11px;
    padding: 2px 10px; font-size: ${fs_tiny}; font-weight: 700;
    font-family: ${font_mono};
    min-height: ${ctl_xs};
}
QPushButton[logLevel]:hover { color: ${c_tyre}; border-color: ${c_tyre}; }
QPushButton[logLevel]:checked { background: ${c_tyre}; color: ${c_on_dark}; border-color: ${c_tyre}; }
QPushButton[logLevel="WARN"]:checked { background: ${c_amber}; border-color: ${c_amber}; }
QPushButton[logLevel="ERROR"]:checked { background: ${c_signal}; border-color: ${c_signal}; }

QLineEdit#logSearch {
    background: ${c_shell}; border: 1px solid ${c_line_strong}; border-radius: 6px;
    color: ${c_tyre}; padding: 2px 8px; font-size: ${fs_small}; min-height: ${ctl_s};
    max-width: 140px;
    font-family: ${font_mono};
}
QLineEdit#logSearch:focus { border-color: ${c_tyre}; }

QPushButton#btnGhost {
    background: ${c_shell}; color: ${c_chassis};
    border: 1px solid ${c_line_strong}; border-radius: 6px;
    padding: 0 9px; font-size: ${fs_small}; font-weight: 600; min-height: ${ctl_s};
}
QPushButton#btnGhost:hover { color: ${c_tyre}; border-color: ${c_tyre}; }
QPushButton#btnGhost:checked { background: ${c_tyre}; color: ${c_on_dark}; border-color: ${c_tyre}; }

QTextEdit#logsBody {
    background: ${c_code_bg}; border: 1px solid ${c_code_bg}; border-radius: 6px;
    color: ${c_code_fg}; padding: 10px 12px;
    font-family: ${font_mono};
    font-size: ${fs_small};
}

/* Environment strip: the black band of the tyres. */
QFrame#envStrip { background: ${c_tyre}; border-bottom: 1px solid ${c_tyre}; }
QLabel#envLabel { color: ${c_faint}; font-size: ${fs_tiny}; font-weight: 700; }
QLabel#envValue {
    color: ${c_lid}; font-size: ${fs_tiny};
    font-family: ${font_mono};
}
QLabel#envSep { color: ${c_chassis}; font-size: ${fs_tiny}; }
QLabel#envOk { color: ${c_lid}; font-size: ${fs_tiny}; font-weight: 700; }
QLabel#envWarn { color: ${c_log_warn}; font-size: ${fs_tiny}; font-weight: 700; }

/* Toasts: black, on top of everything light. */
QFrame#toast { background: ${c_tyre}; border: 1px solid ${c_tyre}; border-radius: 8px; }
QFrame#toast[kind="err"] { border-color: ${c_signal}; }
QLabel#toastTitle { color: ${c_on_dark}; font-size: ${fs_meta}; font-weight: 700; }
QLabel#toastSub { color: ${c_faint}; font-size: ${fs_small}; }
QLabel#toastX { color: ${c_faint}; font-size: ${fs_icon}; padding: 0 4px; }

/* Command palette */
QDialog#paletteRoot { background: ${c_shell}; border: 1px solid ${c_line_strong}; border-radius: 10px; }
QFrame#paletteInputWrap {
    background: ${c_shell}; border-bottom: 1px solid ${c_line};
    border-top-left-radius: 10px; border-top-right-radius: 10px;
}
QLineEdit#paletteInput {
    background: transparent; border: none; color: ${c_tyre};
    font-size: ${fs_large};
}
QListWidget#paletteList {
    background: ${c_shell}; border: none; color: ${c_tyre};
    font-size: ${fs_body}; padding: 4px 0;
    outline: none;
}
QListWidget#paletteList::item {
    padding: 8px 16px; border-radius: 6px; margin: 0 6px;
}
QListWidget#paletteList::item:selected { background: ${c_well}; color: ${c_tyre}; }
QListWidget#paletteList::item:disabled { color: ${c_faint}; }
QLabel#paletteFoot {
    color: ${c_muted}; font-size: ${fs_tiny}; padding: 8px 16px;
    border-top: 1px solid ${c_line};
    border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
}

QScrollArea { border: none; background: ${c_lid}; }
QScrollBar:vertical { background: transparent; width: ${scrollbar}; }
QScrollBar::handle:vertical { background: ${c_line_strong}; border-radius: 5px; min-height: 20px; }
QScrollBar::handle:vertical:hover { background: ${c_chassis}; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QScrollBar:horizontal { background: transparent; height: ${scrollbar}; }
QScrollBar::handle:horizontal { background: ${c_line_strong}; border-radius: 5px; min-width: 20px; }
QScrollBar::handle:horizontal:hover { background: ${c_chassis}; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

QToolTip {
    background: ${c_tyre}; color: ${c_on_dark};
    border: 1px solid ${c_tyre}; padding: 4px 6px;
}
QMenu { background: ${c_shell}; color: ${c_tyre}; border: 1px solid ${c_line_strong}; }
QMenu::item:selected { background: ${c_tyre}; color: ${c_on_dark}; }

/* Launch state additions */
QLabel#statusStopping { color: ${c_amber}; font-size: ${fs_small}; font-weight: 700; }
QLabel#cardDied { color: ${c_signal}; font-size: ${fs_small}; font-weight: 700; }
QLabel#cardWs {
    color: ${c_muted}; font-size: ${fs_tiny};
    font-family: ${font_mono};
}
QLabel#argRequired { color: ${c_signal}; font-size: ${fs_tiny}; font-weight: 700; }
QLineEdit#argText[missing="true"] { border-color: ${c_signal}; background: ${c_signal_bg}; }

/* Graph and TF pages */
QCheckBox { color: ${c_tyre}; font-size: ${fs_meta}; spacing: 6px; }
QCheckBox::indicator {
    width: ${check}; height: ${check};
    border: 1px solid ${c_line_strong}; border-radius: 3px; background: ${c_shell};
}
QCheckBox::indicator:checked { background: ${c_tyre}; border-color: ${c_tyre}; }
QLineEdit#graphSearch {
    background: ${c_shell}; border: 1px solid ${c_line_strong}; border-radius: 6px;
    color: ${c_tyre}; padding: 2px 8px; font-size: ${fs_meta}; min-height: ${ctl_m};
}
QLineEdit#graphSearch:focus { border-color: ${c_tyre}; }
QScrollArea#graphDetailsScroll { border-left: 1px solid ${c_line}; background: ${c_shell}; }
QLabel#graphDetails {
    background: ${c_shell}; color: ${c_tyre}; padding: 14px 16px; font-size: ${fs_meta};
}
QLabel#tfDiagnostics {
    background: ${c_shell}; color: ${c_tyre};
    border-top: 1px solid ${c_line};
    padding: 10px 24px; font-size: ${fs_meta};
}

/* Inline argument help, search button, domain warning, zoom controls */
QLabel#argHelp { color: ${c_chassis}; font-size: ${fs_small}; }
QLabel#argsEmpty { color: ${c_muted}; font-size: ${fs_small}; font-style: italic; }
QLabel#legendText { color: ${c_chassis}; font-size: ${fs_small}; }
QLabel#domainWarn {
    color: ${c_amber}; background: ${c_amber_bg};
    border: 1px solid ${c_amber}; border-radius: 4px;
    font-size: ${fs_tiny}; font-weight: 700;
    padding: 2px 7px;
}
QPushButton#btnSearch {
    background: ${c_shell}; color: ${c_tyre};
    border: 1px solid ${c_line_strong}; border-radius: 6px;
    padding: 4px 14px; font-size: ${fs_meta}; font-weight: 600;
}
QPushButton#btnSearch:hover { border-color: ${c_tyre}; }
QPushButton#paletteClose {
    color: ${c_chassis}; background: ${c_well}; border: 1px solid ${c_line};
    border-radius: 4px; padding: 2px 8px; font-size: ${fs_tiny}; font-weight: 700;
    font-family: ${font_mono};
}
QPushButton#paletteClose:hover { color: ${c_tyre}; border-color: ${c_tyre}; }
QFrame#zoomBar { background: transparent; }
QPushButton#zoomBtn {
    background: ${c_shell}; color: ${c_tyre};
    border: 1px solid ${c_line_strong}; border-radius: 6px;
    min-width: ${ctl_m}; min-height: ${ctl_m}; padding: 0 8px;
    font-size: ${fs_body}; font-weight: 700;
}
QPushButton#zoomBtn:hover { border-color: ${c_tyre}; }

/* Touch launches page (touch_page.py): list beside the detail of the selected launch */
QFrame#listPane { background: ${c_lid}; border-right: 1px solid ${c_line}; }
QFrame#filterSegWrap { background: ${c_lid}; border-bottom: 1px solid ${c_line}; }
QPushButton#filterSeg {
    background: ${c_well}; color: ${c_chassis}; border: 1px solid ${c_line_strong};
    padding: 0 4px; min-height: ${ctl_s}; font-size: ${fs_meta}; font-weight: 700;
}
QPushButton#filterSeg:checked { background: ${c_tyre}; color: ${c_on_dark}; border-color: ${c_tyre}; }
QFrame#launchRow { background: transparent; border-bottom: 1px solid ${c_line}; }
QFrame#launchRow[selected="true"] { background: ${c_shell}; border: 1px solid ${c_tyre}; }
QLabel#rowName { color: ${c_tyre}; font-size: ${fs_large}; font-weight: 700; }
QLabel#rowSub { color: ${c_chassis}; font-size: ${fs_small}; }
QLabel#rowSub[state="running"] { color: ${c_tyre}; font-weight: 700; }
QLabel#rowSub[state="failed"] { color: ${c_signal}; font-weight: 700; }
QLabel#rowSub[state="stopping"] { color: ${c_amber}; font-weight: 700; }
QFrame#detail { background: ${c_shell}; }
QFrame#detail QScrollArea { background: ${c_shell}; }
QWidget#detailPage { background: ${c_shell}; }
QFrame#detail QFrame#logsPanel { background: ${c_shell}; border-top: none; }
QLabel#detailName { color: ${c_tyre}; font-size: ${fs_title}; font-weight: 700; }
QLabel#detailMeta { color: ${c_chassis}; font-size: ${fs_small}; }
QFrame#detailArgs { background: transparent; }
QPushButton#stepBtn {
    background: ${c_shell}; color: ${c_tyre};
    border: 1px solid ${c_line_strong}; border-radius: 6px;
    min-width: ${ctl_s}; min-height: ${ctl_s}; padding: 0;
    font-size: ${fs_body}; font-weight: 700;
}
QPushButton#stepBtn:hover { border-color: ${c_tyre}; }
QPushButton#stepBtn:pressed { background: ${c_tyre}; color: ${c_on_dark}; }
